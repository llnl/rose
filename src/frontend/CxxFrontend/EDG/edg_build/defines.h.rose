  #endif
#endif

#if defined(TARG_SUPPORTS_X86_64) || defined(TARG_SUPPORTS_ARM32) || defined(TARG_SUPPORTS_ARM64)
  #error "None of the TARG_SUPPORTS_*** macro should be defined"
#endif

#if defined(_WIN64) || defined(__x86_64) || defined(__x86_64__) || defined(__INTEL_COMPILER)
  #define TARG_SUPPORTS_X86_64 1
  #define TARG_SUPPORTS_ARM64 0
  #define TARG_SUPPORTS_ARM32 0
#elif defined(__aarch64__)
  #define TARG_SUPPORTS_X86_64 0
  #define TARG_SUPPORTS_ARM64 1
  #define TARG_SUPPORTS_ARM32 0
#elif defined(__arm__)
  #define TARG_SUPPORTS_X86_64 0
  #define TARG_SUPPORTS_ARM64 0
  #define TARG_SUPPORTS_ARM32 1
#endif

#ifndef BUILTIN_FUNCTIONS_ENABLED
  #define BUILTIN_FUNCTIONS_ENABLED 1
#endif

#if TARG_SUPPORTS_X86_64
  #define TARG_SIZEOF_LONG 8
  #define TARG_ALIGNOF_LONG 8
  #define TARG_SIZEOF_POINTER 8
  #define TARG_ALIGNOF_POINTER 8
  #define TARG_SIZEOF_DOUBLE 8
  #define TARG_ALIGNOF_DOUBLE 8
  #define TARG_SIZEOF_LONG_DOUBLE 16
  #define TARG_ALIGNOF_LONG_DOUBLE 16
  #if defined(ROSE_USE_MICROSOFT_EXTENSIONS)
    #define TARG_WCHAR_T_INT_KIND ((an_integer_kind)ik_short)
  #else
    #define TARG_WCHAR_T_INT_KIND ((an_integer_kind)ik_int)
  #endif
  #ifndef _lint
    #define TARG_SIZEOF_WCHAR_T TARG_SIZEOF_INT
  #endif
  #define TARG_SIZE_T_INT_KIND ((an_integer_kind)ik_unsigned_long)
  #define TARG_PTRDIFF_T_INT_KIND ((an_integer_kind)ik_long)
  #define TYPE_FOR_AN_FP_VALUE_PART unsigned int
  #define TARG_DUAL_ALIGNMENTS_FOR_BUILTIN_TYPES 0
  #if defined(__APPLE__)
    #define TARG_SIZEOF_LONG 8
    #define TARG_ALIGNOF_LONG 8
    #define TARG_SIZEOF_POINTER 8
    #define TARG_ALIGNOF_POINTER 8
    #define TARG_ALIGNOF_DOUBLE 8
    #define TARG_WCHAR_T_INT_KIND ((an_integer_kind)ik_int)
    #define HOST_ALIGNMENT_REQUIRED 8
    #define TARG_ALIGNOF_LONG_LONG 8
  #elif defined(__INTEL_COMPILER)
    #define HOST_ALIGNMENT_REQUIRED 8
  #endif
#elif TARG_SUPPORTS_ARM64
  #if defined(__APPLE__)
    #undef TARG_MAXIMUM_PACK_ALIGNMENT
    #undef TYPE_FOR_TARG_ALIGNMENT 
    #define TARG_SIZEOF_LONG 8
    #define TARG_ALIGNOF_LONG 8
    #define TARG_SIZEOF_POINTER 8
    #define TARG_ALIGNOF_POINTER 8
    #define TARG_ALIGNOF_DOUBLE 8
    #define TARG_WCHAR_T_INT_KIND ((an_integer_kind)ik_int)
    #define HOST_ALIGNMENT_REQUIRED 16   /* host integer type is __int128, see INT128 below */
    #define TARG_ALIGNOF_LONG_LONG 8
    #define TARG_SIZEOF_LONG_DOUBLE 8
    #define TARG_ALIGNOF_LONG_DOUBLE 8
    #define TARG_JMP_BUF_NUM_ELEMENTS 48
    #define USE_LONG_DOUBLE_FOR_HOST_FP_VALUE 0
    #define FP_LONG_DOUBLE_IS_BINARY64 1

    #define TARG_SIZE_T_INT_KIND ((an_integer_kind)ik_unsigned_long)
    #define TARG_PTRDIFF_T_INT_KIND ((an_integer_kind)ik_long)
    #define TARG_CHAR_BIT 8
    #define TARG_HAS_SIGNED_CHARS TRUE
    #define TARG_CHAR_CONSTANT_FIRST_CHAR_MOST_SIGNIFICANT TRUE
    #define TARG_SIZEOF_SHORT 2
    #define TARG_ALIGNOF_SHORT 2
    #define TARG_SIZEOF_INT 4
    #define TARG_ALIGNOF_INT 4
    #define TARG_SIZEOF_FLOAT 4
    #define TARG_ALIGNOF_FLOAT 4
    #define TARG_SIZEOF_DOUBLE 8
    #define TARG_RIGHT_SHIFT_IS_ARITHMETIC 1
    #define TARG_MINIMUM_STRUCT_ALIGNMENT 1
    #define TARG_JMP_BUF_ELEMENTS_ARE_FLOAT 0
    #define TARG_JMP_BUF_ELEMENT_INT_KIND ((an_integer_kind)ik_int)
    #ifndef ACCEPT_UNRECOGNIZED_GNU_ASM_OPERANDS
      #define ACCEPT_UNRECOGNIZED_GNU_ASM_OPERANDS 1
    #endif
    #define GUARD_MACRO_FOR_VA_LIST "_VA_LIST"
    #define C99_IL_EXTENSIONS_SUPPORTED 1
    #define UNICODE_SOURCE_SUPPORTED 1
    #define DEFAULT_UNICODE_SOURCE_KIND usk_utf8
    #ifndef DEFAULT_EMULATE_GNU_ABI_BUGS
      #define DEFAULT_EMULATE_GNU_ABI_BUGS 0
    #endif
    #ifndef CP_GEN_BE_VERSION
      #ifndef GCC_IS_GENERATED_CODE_TARGET
        #define GCC_IS_GENERATED_CODE_TARGET 0
      #endif
      #ifndef CLANG_IS_GENERATED_CODE_TARGET
        #define CLANG_IS_GENERATED_CODE_TARGET 1
      #endif
    #endif
  #else
    #define TARG_HAS_SIGNED_CHARS FALSE
    #define TARG_SIZEOF_LONG 8
    #define TARG_ALIGNOF_LONG 8
    #define TARG_SIZEOF_POINTER 8
    #define TARG_ALIGNOF_POINTER 8
    #define TARG_SIZEOF_LONG_DOUBLE 16
    #define TARG_ALIGNOF_LONG_DOUBLE 16
    #define TARG_WCHAR_T_INT_KIND ((an_integer_kind)ik_unsigned_int)
    #define TARG_SIZE_T_INT_KIND ((an_integer_kind)ik_unsigned_long)
    #define TARG_PTRDIFF_T_INT_KIND ((an_integer_kind)ik_long)
    #define HOST_ALIGNMENT_REQUIRED 8
    #define TARG_JMP_BUF_NUM_ELEMENTS 39
    #define TARG_JMP_BUF_ELEMENT_INT_KIND ((an_integer_kind)ik_long_long)
  #endif
#else
  #if defined(__x86_64)
    #define TYPE_FOR_AN_FP_VALUE_PART unsigned int
  #endif
  #ifndef __sun
    #define TARG_ALIGNOF_LONG_DOUBLE 4
    #define TARG_SIZEOF_LONG_DOUBLE 12
    #define TARG_JMP_BUF_NUM_ELEMENTS 39
  #endif
  #ifndef C_GEN_BE_GENERATES_ANSI_C
    #define C_GEN_BE_GENERATES_ANSI_C 1
  #endif

  #if defined(ROSE_USE_MICROSOFT_EXTENSIONS)
    #define TARG_WCHAR_T_INT_KIND ((an_integer_kind)ik_short)
  #else
    #define TARG_WCHAR_T_INT_KIND ((an_integer_kind)ik_long)
  #endif
  #ifndef _lint
    #define TARG_SIZEOF_WCHAR_T TARG_SIZEOF_LONG
  #endif
  #define TARG_DOUBLE_FIELD_ALIGNMENT 4
  #define TARG_LONG_LONG_FIELD_ALIGNMENT 4
#endif

#define TARG_WINT_T_INT_KIND ((an_integer_kind)ik_unsigned_int)

#define TARG_ALIGNOF_DOUBLE 8
#define TARG_ALIGNOF_LONG_LONG 8

#define MAKE_ALL_FUNCTIONS_UNPROTOTYPED 0
#define DESIGNATED_INITIALIZER_ENABLING_POSSIBLE 1
#ifndef RUNTIME_USES_NAMESPACES
  #define RUNTIME_USES_NAMESPACES 1
#endif
#define BUILTIN_VA_LIST_OVERRIDE_TYPE_NAME "__gnuc_va_list"
#define DEFAULT_PASS_STDARG_REFERENCES_TO_GENERATED_CODE 1
#define TARG_EXTERNAL_NAMES_GET_UNDERSCORE_ADDED 0
#define IGNORE_CARRIAGE_RETURN_IN_SOURCE 1
#ifndef GNU_EXTENSIONS_ALLOWED
  #define GNU_EXTENSIONS_ALLOWED 1
#endif
#if defined(__GNUC__) && !defined(GNU_INIT_PRIORITY_ATTRIBUTE_ALLOWED)
  #define GNU_INIT_PRIORITY_ATTRIBUTE_ALLOWED 1
#endif
#if !defined(RECORD_RAW_ASM_OPERAND_DESCRIPTIONS)
  #define RECORD_RAW_ASM_OPERAND_DESCRIPTIONS 0
#endif
#define DEFAULT_GNU_COMPATIBILITY 0
#define DEFAULT_USE_PREDEFINED_MACRO_FILE 0
#ifndef IA64_ABI
  #define IA64_ABI 1
#endif

#define TARG_BIT_FIELD_CONTAINER_SIZE (-1)
#define ALLOW_NON_INT_BIT_FIELD_BASE_TYPE_IN_GENERATED_C 1
#define TARG_PLAIN_INT_BIT_FIELD_IS_UNSIGNED 0
#define TARG_NONNEGATIVE_ENUM_BIT_FIELD_IS_UNSIGNED 1

#define LONG_LONG_ALLOWED 1
#ifndef INTEGER_VALUE_REPR_IS_A_HOST_INTEGER
  #define INTEGER_VALUE_REPR_IS_A_HOST_INTEGER 1
#endif

#ifndef _MSC_VER
  #if defined(BACKEND_CXX_IS_GNU_COMPILER) || defined(BACKEND_CXX_IS_INTEL_COMPILER)
    #if (__WORDSIZE == 64)
      #define TYPE_FOR_AN_INTEGER_VALUE unsigned __int128
      #define TYPE_FOR_A_SIGNED_INTEGER_VALUE __int128
      #define INT128_EXTENSIONS_ALLOWED 1
    #else
      #define TYPE_FOR_AN_INTEGER_VALUE unsigned long long
      #define TYPE_FOR_A_SIGNED_INTEGER_VALUE long long
    #endif
  #elif defined(BACKEND_CXX_IS_CLANG_COMPILER)
    /* clang has __int128 on every 64-bit target, including Apple arm64 (upstream EDG's own macOS arm64
       configuration enables INT128 too). ROSE's compiler macro headers predefine __SIZEOF_INT128__ for
       clang, so libc++ specialises on __int128_t; with INT128 disabled EDG maps that to long long and
       the specialisations collide ("has already been defined"). */
    #define TYPE_FOR_AN_INTEGER_VALUE unsigned __int128
    #define TYPE_FOR_A_SIGNED_INTEGER_VALUE __int128
    #define INT128_EXTENSIONS_ALLOWED 1
  #else
    #define TYPE_FOR_AN_INTEGER_VALUE unsigned long long
    #define TYPE_FOR_A_SIGNED_INTEGER_VALUE long long
  #endif
#else
  #define TYPE_FOR_AN_INTEGER_VALUE unsigned long long
  #define TYPE_FOR_A_SIGNED_INTEGER_VALUE long long
#endif

#define MAX_INTEGER_VALUE 9223372036854775807LL
#define MIN_INTEGER_VALUE (-MAX_INTEGER_VALUE-1)
#define MAX_UNSIGNED_INTEGER_VALUE 18446744073709551615ULL

/* EDG 7.0 features ROSE does not use (upstream's configuration enables them; left undefined they
   would read as 0 anyway, this makes the choice explicit). */
#define REFLECTION_ENABLING_POSSIBLE 0
#define RISCV_VECTOR_BUILTINS_ENABLED 0

#define LITERALS_AS_STRINGS_SUPPORT 1
#define FLOAT_SUPPORT_MAX_SIZE_OF_FLOAT_LEXEMES 128
#define INT_SUPPORT_MAX_SIZE_OF_INT_LEXEMES 24

#if defined(ROSE_USE_EDG_QUAD_FLOAT) && !defined(_MSC_VER)
  #define FLOAT128_ENABLING_POSSIBLE 1
  #define USE_FLOAT128_FOR_HOST_FP_VALUE 1
  /* Approximate __float128 conversions using long double routines instead of
     relying on the GNU quadmath library. This removes the -lquadmath link
     dependency; only the string<->value conversions done in float_pt.cc lose
     precision beyond long double, the internal representation stays 128-bit. */
  #define APPROXIMATE_QUADMATH 1
#endif

#define ENABLE_CUDA_SUPPORT 1
#define ROSE_MISC 1

#define USE_EDG_NAMESPACE 0
#define BSEARCH_QSORT_FUNCTION_IS_EXTERN_C 0

#define ALLOW_HOST_FP_TOO_SMALL_FOR_LARGEST_FIXED_POINT_TYPE 1

/* Host long double representation (see floating.h). EDG 7.0's float_pt_init() needs exactly one
   of these when USE_FLOAT128_FOR_HOST_FP_VALUE is set; upstream's defines_linux.h chooses by
   architecture, we use the compiler's description of long double and fall back to that. The Apple
   arm64 section above has already chosen FP_LONG_DOUBLE_IS_BINARY64. */
#if !defined(FP_LONG_DOUBLE_IS_80BIT_EXTENDED) && !defined(FP_LONG_DOUBLE_IS_BINARY128) && \
    !defined(FP_LONG_DOUBLE_IS_BINARY64)
  #if defined(__LDBL_MANT_DIG__) && __LDBL_MANT_DIG__ == 64
    #define FP_LONG_DOUBLE_IS_80BIT_EXTENDED 1
  #elif defined(__LDBL_MANT_DIG__) && __LDBL_MANT_DIG__ == 113
    #define FP_LONG_DOUBLE_IS_BINARY128 1
  #elif defined(__LDBL_MANT_DIG__) && __LDBL_MANT_DIG__ == 53
    #define FP_LONG_DOUBLE_IS_BINARY64 1
  #elif defined(__aarch64__) || defined(__riscv)
    #define FP_LONG_DOUBLE_IS_BINARY128 1
  #else
    #define FP_LONG_DOUBLE_IS_80BIT_EXTENDED 1
  #endif
#endif

#endif /* ifndef DEFINES_ROSE_H */

