# ROSE's configuration of the EDG C/C++ front end: macro configuration set "rose", file "base".
#
# Format: EDG's cmakedef (see edg_compiler/cmake/macro-conf and dev_tools/bin/edg-cmakedef):
# "NAME=VALUE" defines NAME, "NAME" defines it as 1, "NAME=" defines it empty, "#" starts a
# comment, "import <path>" reads <root>/path.cmakedef, a later line overrides an earlier one.
# EDG's build turns the result into cmake_defines.h (every entry wrapped in #ifndef) which
# EDG's src/defines.h includes when USE_CMAKE_DEFINES is defined.
#
# This file holds the host-independent part of the configuration.  Everything that depends
# on the host, on the backend compiler ROSE was configured for or on ROSE's options, and the
# target description printed by EDG's dettarg utility, is generated into host.cmakedef by
# ../../CMakeLists.txt and imported at the end of this file (so it overrides what is here,
# exactly as the appended dettarg output used to override defines.h.rose).
#
# Derived from defines.h.rose (ROSE's edit of EDG's configuration template), which is kept
# in this directory only for the deprecated autotools build.  SPDX-License-Identifier:
# Apache-2.0 WITH LLVM-exception (the license of EDG's template).

COMPILE_MULTIPLE_SOURCE_FILES=0
BACK_END_IS_C_GEN_BE=0
BACK_END_IS_CP_GEN_BE=1
TEMPORARILY_EXTEND_USE_OF_SSI_CP_GEN_BE=1
NO_VLA_DIMENSION_TEMPORARIES_IN_FUNCTION_PROTOTYPES=0
DEFAULT_VLA_ENABLED=1
EXTRA_SOURCE_POSITIONS_IN_IL=1

# Not a stand-alone utility: the front end is driven by edgRose.
STANDALONE_IL_DISPLAY=0
STANDALONE_C_GEN_BE=0
STANDALONE_CP_GEN_BE=0
BACK_END_SHOULD_BE_CALLED=1
STANDALONE_UTILITY_PROGRAM=0

RECORD_MACRO_INVOCATIONS=1
MACRO_INVOCATION_TREE_IN_IL=1
CLASS_TEMPLATE_INSTANTIATIONS_IN_SOURCE_SEQUENCE_LISTS=1
NONCLASS_TEMPLATE_INSTANTIATIONS_IN_SOURCE_SEQUENCE_LISTS=1
PROTOTYPE_INSTANTIATIONS_IN_IL=1
INSTANTIATE_TEMPLATES_EVERYWHERE_USED=1
AUTOMATIC_TEMPLATE_INSTANTIATION=1
PRAGMA_DEFINE_TYPE_INFO_IS_REQUIRED=0
DEFAULT_REMOVE_UNNEEDED_ENTITIES=0
RECORD_NAME_IN_PARAM_TYPE_ENTRY=1
DO_IL_LOWERING=0
GENERATE_SOURCE_SEQUENCE_LISTS=1
DEFAULT_INSTANTIATIONS_PERMITTED_IN_CLASS_SRC_SEQ_LIST=1
FRIEND_AND_MEMBER_DEFINITIONS_MAY_BE_MOVED_OUT_OF_CLASS=0
INCLUDE_UNRECOGNIZED_PRAGMAS_IN_IL=1
RECORD_TEMPLATE_STRINGS=1
RECORD_MACROS_IN_IL=1
EDG_AUXILIARY_INFO_DIR_NAME="."
REPRESENT_EMPTY_STATEMENTS_IN_IL=1
RECORD_FORM_OF_NAME_REFERENCE=1
DOING_SOURCE_ANALYSIS=1
DUMP_CONFIG_ENABLED=1
MAX_PENDING_INSTANTIATIONS=(64 * 1000)
MAX_TOTAL_PENDING_INSTANTIATIONS=(256 * 1000)
MAX_UNUSED_ALL_MODE_INSTANTIATIONS=(200 * 1000)
DEFAULT_MAX_CONSTEXPR_CALL_DEPTH=(1000 * 100)
DEFAULT_MAX_CONSTEXPR_CALL_COUNT=(50000 * 100)

# GNU or Microsoft extensions: see host.cmakedef (GNU_EXTENSIONS_ALLOWED and the rest).

DEFAULT_EXCEPTIONS_ENABLED=1
DEFAULT_DEPENDENT_NAME_PROCESSING=1
UPC_EXTENSIONS_ALLOWED=1
DEFAULT_C99_MODE=1
BUILTIN_FUNCTIONS_ENABLED=FALSE
END_OF_LINE_COMMENTS_ALLOWED_IN_C_MODE=1

# Embedded C: see host.cmakedef (not on macOS).

DEFINE_PORTABLE_FEATURE_TEST_MACROS=TRUE
DEFINE_FEATURE_TEST_MACRO_OPERATORS_IN_ALL_MODES=TRUE
USER_CONTROL_OF_STRUCT_PACKING=1
DEFAULT_ALLOW_ANACHRONISMS=1
C_ANACHRONISMS_ALLOWED=1
DEFAULT_VARIADIC_MACROS_ALLOWED=1
GCC_BUILTIN_VARARGS_IN_GENERATED_CODE=1
PRESERVE_EFFECTLESS_EXPLICIT_CASTS_IN_IL=1
PRESERVE_TOP_LEVEL_CASTS_TO_VOID_IN_IL=1
UNARY_PLUS_IN_IL=1
FAVOR_CONSTANT_RESULT_FOR_NONSTATIC_INIT=0
TARG_MAXIMUM_PACK_ALIGNMENT=16384
TYPE_FOR_TARG_ALIGNMENT=uint16_t
DECL_MODIFIERS_IN_USE=1
DEFAULT_COMPRESS_MANGLED_NAMES=1
THREAD_LOCAL_STORAGE_SPECIFIER_ALLOWED=1
USING_DRIVER=1
WRITE_SIGNOFF_MESSAGE=0
__ANSIC__=1
_BSD_SOURCE=

# Target description: the architecture-dependent part and dettarg's output are in
# host.cmakedef; these two are the host-independent defaults of defines.h.rose.
TARG_WINT_T_INT_KIND=((an_integer_kind)ik_unsigned_int)
TARG_ALIGNOF_DOUBLE=8
TARG_ALIGNOF_LONG_LONG=8

MAKE_ALL_FUNCTIONS_UNPROTOTYPED=0
DESIGNATED_INITIALIZER_ENABLING_POSSIBLE=1
RUNTIME_USES_NAMESPACES=1
BUILTIN_VA_LIST_OVERRIDE_TYPE_NAME="__gnuc_va_list"
DEFAULT_PASS_STDARG_REFERENCES_TO_GENERATED_CODE=1
TARG_EXTERNAL_NAMES_GET_UNDERSCORE_ADDED=0
IGNORE_CARRIAGE_RETURN_IN_SOURCE=1
DEFAULT_GNU_COMPATIBILITY=0
DEFAULT_USE_PREDEFINED_MACRO_FILE=0
IA64_ABI=1
TARG_BIT_FIELD_CONTAINER_SIZE=(-1)
ALLOW_NON_INT_BIT_FIELD_BASE_TYPE_IN_GENERATED_C=1
TARG_PLAIN_INT_BIT_FIELD_IS_UNSIGNED=0
TARG_NONNEGATIVE_ENUM_BIT_FIELD_IS_UNSIGNED=1
LONG_LONG_ALLOWED=1
INTEGER_VALUE_REPR_IS_A_HOST_INTEGER=1

# TYPE_FOR_AN_INTEGER_VALUE / TYPE_FOR_A_SIGNED_INTEGER_VALUE / INT128_EXTENSIONS_ALLOWED
# depend on the backend compiler: see host.cmakedef.
MAX_INTEGER_VALUE=9223372036854775807LL
MIN_INTEGER_VALUE=(-MAX_INTEGER_VALUE-1)
MAX_UNSIGNED_INTEGER_VALUE=18446744073709551615ULL

# EDG 7.0 features ROSE does not use (upstream's configuration enables them; left undefined
# they would read as 0 anyway, this makes the choice explicit).
REFLECTION_ENABLING_POSSIBLE=0
RISCV_VECTOR_BUILTINS_ENABLED=0

# ROSE's own additions to EDG (see ROSE-PATCHES.md in edg_compiler).
LITERALS_AS_STRINGS_SUPPORT=1
FLOAT_SUPPORT_MAX_SIZE_OF_FLOAT_LEXEMES=128
INT_SUPPORT_MAX_SIZE_OF_INT_LEXEMES=24
ENABLE_CUDA_SUPPORT=1
ROSE_MISC=1

USE_EDG_NAMESPACE=0
BSEARCH_QSORT_FUNCTION_IS_EXTERN_C=0
ALLOW_HOST_FP_TOO_SMALL_FOR_LARGEST_FIXED_POINT_TYPE=1

# Host-, backend- and option-dependent entries, then dettarg's target description.
import <rose/host>
