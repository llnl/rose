
namespace EDG_ROSE_Translation {

template <typename T>
SgName generateName(T p)
   {
     ROSE_ASSERT(p != NULL);
#if 0
     printf ("In generateName(): p->source_corresp.name = %s \n",p->source_corresp.name);
#endif

  // Types can be more complex (sometimes without a name).
     SgName name = p->source_corresp.name == NULL ? generate_name_for_type(p) : p->source_corresp.name;
#if 0
     printf ("In generateName(): name = %s \n",name.str());
#endif

  // If this is a template instantiation, then we have to append the template arguments.
     bool isATemplateInstantiation = isTemplateInstantiation(p);
#if 0
     printf ("In generateName(): isATemplateInstantiation = %s \n",isATemplateInstantiation ? "true" : "false");
#endif

     if (isATemplateInstantiation == true)
        {
#if 0
          printf ("In generateName(): This is a template instantiation \n");
#endif
        }

  // DQ (5/10/2016): Debugging case of C++11 using the Intel v16 compiler and it's associated mutex header file.
  // See Cxx11_tests/test2016_32.C for an example that demonstrates this problem.   This comes from the type
  // name generated by the auto variable declaration within a template.
     if (name == "<unnamed>")
        {
          name = generate_name_for_type(p);
#if 0
          printf ("In generateName(): Identified case of name == <unnamed>: using name = %s \n",name.str());
#endif
        }


#if 0
     printf ("Returning from generateName(): name = %s \n",name.str());
#endif

     return name;
   }

template <class FunctionDeclaration>
void parse_function_body(const SourceSequenceList& sse_base, a_routine_ptr p, FunctionDeclaration* decl)
   {
  // This function is run on the body of the function in the AST, and should not change that pointer (unlike the other parse routines that modify their sse pointers).
     SourceSequenceList sse = sse_base;

#ifdef DEBUG_CONVERSION
     indent_line(); debug_print("function definition information\n");
     ScopedIndent si(indent);
#endif

  // DQ (7/29/2014): Added test on sse (since it is NULL where a C++11 member function is marked as default or delete).
     ROSE_ASSERT (sse);

  // DQ (5/13/2012): Make sure we have a proper definition in place for this function declaration.
     ROSE_ASSERT(decl != NULL);
     ROSE_ASSERT(decl->get_definition() != NULL);
     ROSE_ASSERT(isSgFunctionDefinition(decl->get_definition()) != NULL);

  // DQ (8/21/2012): Check that there is a SgBasicBlock as a body in place.
     ROSE_ASSERT(decl->get_definition()->get_body() != NULL);

     a_scope_ptr scope = NULL;
     if (p->function_def_number != NULL_function_def_number)
        {
       // Note that p->assoc_scope is an EDG specific scope number (not a pointer to a scope).
          scope = il_header.function_def_table[p->function_def_number].scope;
        }
#if 0
     printf ("In parse_function_body(): scope = %p \n",scope);
#endif

  // DQ (2/25/2012): We need this to in some rare cases where we have refer to the function (or it's return type as in test2012_08.C)
  // We are now processing the current function so record it as the current inner most scope.
     global_innermost_function_scope = scope;

  // DQ (3/31/2012): Allow this to be NULL for test2012_58.C.
  // ROSE_ASSERT(global_innermost_function_scope != NULL);
     if (global_innermost_function_scope == NULL)
        {
          printf ("WARNING: global_innermost_function_scope == NULL \n");
        }

#if 0
     printf ("In parse_function_body(): decl->get_name() = %s global_innermost_function_scope = %p \n",decl->get_name().str(),global_innermost_function_scope);
#endif
  
     bool usingOldStypeFunctionParameterSpecification = false;
     ROSE_ASSERT(p != NULL);
     ROSE_ASSERT(p->type != NULL);
     ROSE_ASSERT(p->type->variant.routine.extra_info != NULL);
     if (p->type->variant.routine.extra_info->old_style_params_scanned == true)
        {
       // Mark this function as using old style c function parameters (declarations).
#if 0
          printf ("############################################################################################## \n");
          printf ("Detected use of old style C function parameters: decl = %p \n",decl);
          printf ("############################################################################################## \n");
#endif

       // DQ (8/29/2020): I think this is set incorrectly.
       // usingOldStypeFunctionParameterSpecification = false;
          usingOldStypeFunctionParameterSpecification = true;
        }

  // DQ (8/11/2012): At this point the function parameters have already been built (we had to build then early to 
  // compute the function type, but now EDG wants to traverse them in the source sequence list. So iterate through
  // the EDG source sequence list, and build the symbols for each variable into the function definition's symbol table.
  // Since this is where the process the function parameters for the defining declaration, we need to check if any
  // function parameters have default arguments and add then here.  Previous construction of the default parameters 
  // has been based on the function type information and is the same for all functions (prototypes).  In the case 
  // where this is the first time this function is seen (no function prototype) then all the default function 
  // parameter values will be present here.

        {
       // Function parameters
#ifdef DEBUG_CONVERSION
          indent_line(); debug_print("function parameters\n");
          ScopedIndent si(indent);
#endif
          size_t functionParameterCounter = 0;

          while (sse)
             {
               an_il_entry_kind kind = (an_il_entry_kind)(sse->entity.kind);
#if 0
            // DQ (1/30/2013): Note that there is some problem in compiling Cxx_Grammar.C such that the function body is not handled properly below.
               printf ("In parse_function_body(): (these be the function parameters) entry_kind = %p = %s \n",sse->entity.ptr,summarize_entry_kind_in_string_kind(sse->entity).c_str());
#endif
               if (kind != iek_variable)
                  {
                 // DQ (1/5/2014): I think that test2014_16.c demonstrates that this test (for when to break out of 
                 // the loop over the function parameters in the source sequence list) is correct.  Where type declarations
                 // have not been seen previously, we have to skip over the assocated secondary type declaration???
                 // This happens for codes such as: "void foobar( const struct foo_struct *foo )".

                 // DQ (2/11/2013): It might be that the problem with compiling "rose.h" is that we are not incrementing the sse in this case.
                 // So we end up with kind == src-seq-sublist.
#if 0
                    printf ("In parse_function_body(): kind != iek_variable: exiting loop! \n");
#endif
                 // DQ (2/12/2013): Where kind == iek_src_seq_sublist, then increment the sse (see test2013_62.C).
                    if (kind == iek_src_seq_sublist)
                       {
#if 0
                         printf ("In parse_function_body(): (Where kind == iek_src_seq_sublist, then increment the sse) entry_kind = %p = %s \n",
                              sse->entity.ptr,summarize_entry_kind_in_string_kind(sse->entity).c_str());
#endif
                         ++sse;
                       }
                      else
                       {
                      // DQ (1/5/2014): Added this case for test2014_17.c (simplification of test2014_04, but not a simple as test2014_16.c).
                         an_il_entry_kind kind = (an_il_entry_kind)(sse->entity.kind);
                         if (kind == iek_src_seq_secondary_decl)
                            {
#if 0
                              printf ("In parse_function_body(): (Where kind == iek_src_seq_secondary_decl, then increment the sse) entry_kind = %p = %s \n",
                                   sse->entity.ptr,summarize_entry_kind_in_string_kind(sse->entity).c_str());
#endif
                              ++sse;
                            }
                       }
#if 0
                    break;
#else
                 // DQ (1/5/2014): If this is still a variable (after skipping over the src_seq_sublist, then don't break.
                    if ((an_il_entry_kind)(sse->entity.kind) != iek_variable)
                       {
                         break;
                       }
                      else
                       {
#if 0
                         printf ("In parse_function_body(): Detected sublist, skipped over it and found another variable, so keep processing function parameter list \n");
#endif
                       }
#endif
                  }

               a_variable_ptr var = (a_variable_ptr)(sse->entity.ptr);
               ROSE_ASSERT (var != NULL);
  
            // DQ (2/5/2014): I think that we can enforce this.
               ROSE_ASSERT((an_il_entry_kind)(sse->entity.kind) == iek_variable);
#if 0
               printf ("In parse_function_body(): calling summarize_variable(): var = %p \n",var);
               summarize_variable(var);
#endif
            // DQ (11/6/2014): Adding C++11 support to record the use of C++11 syntax (for the unparser).
               if (var->has_direct_braced_initializer == true)
                  {
                    printf ("In parse_function_body(): Need to mark as using C++11 braced initializer syntax \n");
                    ROSE_ASSERT(false);
                  }

            // DQ (8/11/2012): New code to use the existing function parameters already setup.
               ROSE_ASSERT(functionParameterCounter < decl->get_args().size());
               SgInitializedName* param = decl->get_args()[functionParameterCounter++];
               ROSE_ASSERT (param != NULL);
#if 0
            // DQ (2/5/2014): Output the mapping of old style function parameters to the source sequence entries.  
            // This order does not have to match the order in the function parameter list (demonstrated in test2014_88.c).
               printf ("functionParameterCounter = %" PRIuPTR " param = %p = %s param->get_type() = %p = %s \n",functionParameterCounter-1,
                    param,param->get_name().str(),param->get_type(),param->get_type()->class_name().c_str());
#endif
               SgVariableSymbol* param_sym = NULL;
               if (usingOldStypeFunctionParameterSpecification == true)
                  {
                    ROSE_ASSERT(var->source_corresp.name != NULL);
                    SgName var_name = var->source_corresp.name;
#if 0
                    printf ("In parse_function_body(): test 1: calling lookup_variable_symbol(): var_name = %s \n",var_name.str());
                    printf ("In parse_function_body(): test 1: calling lookup_variable_symbol(): param->get_name() = %s \n",param->get_name().str());
#endif
                    ROSE_ASSERT(decl->get_definition() != NULL);

                    if (param->get_name() == var_name)
                       {
                      // DQ (2/5/2014): This is the only case we used to handle, but it didn't permit the variable 
                      // declaration order to be different between the function declaration and the old-style function 
                      // parameter declaration outside of the function declaration.
                         param_sym = decl->get_definition()->lookup_variable_symbol(param->get_name());
                         ROSE_ASSERT (param_sym != NULL);
                       }
                      else
                       {
                      // DQ (2/5/2014): The order of the variables in the function declaration's parameter list is 
                      // different from the specification of the variable declarations outside of the function 
                      // declaration's paramter list.
#if 0
                         printf ("In parse_function_body(): Detected old-style function parameters in different order than the function parameters in the declaration: var_name = %s param->get_name() = %s \n",
                              var_name.str(),param->get_name().str());
#endif
                         param_sym = decl->get_definition()->lookup_variable_symbol(var_name);
                         ROSE_ASSERT (param_sym != NULL);
                       }
                  }
                 else
                  {
                 // This is the simpler C++ cases since C++ does not permit old style parameter declarations.
#if 0
                    printf ("In parse_function_body(): test 2: calling lookup_variable_symbol(): param->get_name() = %s \n",param->get_name().str());
#endif
                    param_sym = decl->get_definition()->lookup_variable_symbol(param->get_name());
                    ROSE_ASSERT (param_sym != NULL);
                  }

            // DQ (2/5/2014): I think that this should already be in the variable_cache, and if so we don't want to reset the entry in the variable_cache.
               if (variable_cache.find(var) != variable_cache.end())
                  {
                 // Check that the entry in the cache is correct.
                    ROSE_ASSERT(variable_cache[var] != NULL);
                    if (variable_cache[var] != param_sym)
                       {
#if 0
                         printf ("Warning: resetting the variable_cache[var] entry = %p to param_sym = %p \n",variable_cache[var],param_sym);
#endif
#if 0
                         printf ("In parse_function_body(): test 1: Putting param_sym name = %s into variable_cache using key var = %p EDG name = %s \n",param_sym->get_name().str(),var,var->source_corresp.name);
#endif
                      // DQ (8/29/2020): Avoid putting NULL pointers into the variable_cache.
                         ROSE_ASSERT(param_sym != NULL);

                         variable_cache[var] = param_sym;
                       }
                  }
                 else
                  {
                 // Update the variable cache so that we have simple access to the mapping from edg variables to ROSE SgInitializedName objects.
#if 0
                    printf ("In parse_function_body(): NOT SKIPPED: test 2: Putting param_sym name = %s into variable_cache using key var = %p EDG name = %s \n",param_sym->get_name().str(),var,var->source_corresp.name);
#endif
                 // DQ (8/29/2020): Avoid putting NULL pointers into the variable_cache.
                    ROSE_ASSERT(param_sym != NULL);

                 // DQ (8/29/2020): Comment this out as a test!
                    variable_cache[var] = param_sym;
                  }
               ++sse;
             }
        }

#if 0
     printf ("In parse_function_body(): (after processing the function parameters) \n");
#endif

     ROSE_ASSERT (sse);
     ROSE_ASSERT (p->type->kind == tk_routine);
     a_routine_type_supplement_ptr sup = p->type->variant.routine.extra_info;
     ROSE_ASSERT (sup != NULL);

        {
       // Function body
#ifdef DEBUG_CONVERSION
          indent_line(); debug_print("function body\n");
          ScopedIndent si(indent);
#endif
          an_il_entry_kind kind = (an_il_entry_kind)(sse->entity.kind);

          if (kind != iek_statement)
             {
            // This branch is taken for ROSE compiling Cxx_Grammar.C (ROSE source file).
               printf ("ERROR: In parse_function_body(): (this should have been a function body) entry_kind = %p = %s \n",sse->entity.ptr,summarize_entry_kind_in_string_kind(sse->entity).c_str());
             }

#if 0
          a_statement_ptr p = (a_statement_ptr)(sse->entity.ptr);
          printf ("In parse_function_body(): calling sumarize_statement() \n");
          summarize_statement(p);
#endif

             {
#if 0
               printf ("***************************************************************************************** \n");
               printf (" It is a problem to call parse_statement(sse) before building the SgBasicBlock (for C++)  \n");
               printf ("    topScopeStack() = %p = %s \n",topScopeStack(),topScopeStack()->class_name().c_str());
               printf ("***************************************************************************************** \n");
#endif
            // DQ (12/30/2011): Fixup the scope stack so that name mangling can work...C++ specific issue.
               ROSE_ASSERT(decl->get_definition() != NULL);
               ROSE_ASSERT(isSgFunctionDefinition(decl->get_definition()) != NULL);
               ROSE_ASSERT(topScopeStack() != decl->get_definition());

#if DEBUG_PUSH_SCOPE
               printf ("In parse_function_body(): push scope stack: function definition = %p = %s \n",decl->get_definition(),decl->get_definition()->class_name().c_str());
#endif

               pushScopeStack(decl->get_definition());
#if 0
               printf ("In parse_function_body(): decl->get_definition()->get_body() = %p \n",decl->get_definition()->get_body());
#endif
               ROSE_ASSERT(decl->get_definition()->get_body() != NULL);
               ROSE_ASSERT(isSgBasicBlock(decl->get_definition()->get_body()) != NULL);

            // DQ (8/21/2012): Reuse the SgBasicBlock defined in the SgFunctionDefinition's body.
            // DQ (12/30/2011): It is a problem to parse the statements before having the body in place to support traversing the scopes backward to the root of the AST.
            // This works for C code but is a problem for C++ code.
               vector<SgStatement*> raw_body = parse_statement(sse,decl->get_definition()->get_body());
#if 0
               printf ("In parse_function_body(): raw_body.size() = %" PRIuPTR " \n",raw_body.size());
               if (raw_body.size() == 1)
                  {
                    printf ("In parse_function_body(): raw_body[0] = %p = %s \n",raw_body[0],raw_body[0]->class_name().c_str());
                  }
#endif
               SgBasicBlock* body = (raw_body.size() == 1 && isSgBasicBlock(raw_body[0])) ? isSgBasicBlock(raw_body[0]) : set_generated_file_info_to_unparse(buildBasicBlock_nfi(raw_body));
               ROSE_ASSERT (body != NULL);
#if 0
               printf ("In parse_function_body(): body = %p = %s \n",body,body->class_name().c_str());
               body->get_startOfConstruct()->display("body startOfConstruct: debug");
               body->get_endOfConstruct()  ->display("body endOfConstruct: debug");
#endif
               ROSE_ASSERT (decl != NULL);
               ROSE_ASSERT (decl->get_definition() != NULL);

               ROSE_ASSERT(decl->get_definition()->get_body() != NULL);
               ROSE_ASSERT(decl->get_definition()->get_body()->get_startOfConstruct() != NULL);
#if 0
               printf ("In parse_function_body(): decl->get_definition()->get_body() = %p \n",decl->get_definition()->get_body());
               decl->get_definition()->get_body()->get_startOfConstruct()->display("decl->get_definition()->get_body() startOfConstruct: debug");
               decl->get_definition()->get_body()->get_endOfConstruct()  ->display("decl->get_definition()->get_body() endOfConstruct: debug");
#endif

            // DQ (8/21/2012): This fails for only a few cases (e.g test2012_101.C)
               if (body->get_parent() != decl->get_definition())
                  {
                    mprintf ("Resetting the body's parent to be the SgFunctionDefinition body = %p \n",body);
                    body->set_parent(decl->get_definition());
                  }

            // DQ (8/21/2012): Now that we reuse the SgFunctionDefinition's body (a SgBasicBlock) we can avoid the complexity of reconsiling the two SgBasicBlocks.
            // body->set_parent(decl->get_definition());
               ROSE_ASSERT(body->get_parent() == decl->get_definition());
            // DQ (8/21/2012): We want to use the original body that came with the SgFunctionDefinition.
               *(decl->get_definition()->get_startOfConstruct()) = *(body->get_startOfConstruct());
               *(decl->get_definition()->get_endOfConstruct())   = *(body->get_endOfConstruct());

#if DEBUG_POP_SCOPE
               printf ("In parse_function_body(): calling popScopeStack() \n");
#endif
            // DQ (12/30/2011): And don't forget to pop the stack.
               popScopeStack();
             }
       }

  // DQ (2/25/2012): Moved this to the top so it could be used to define the associated function scope.
     process_static_local_variable_initializers(scope);

     ROSE_ASSERT(decl->get_definition() != NULL);
     ROSE_ASSERT(decl->get_definition()->get_startOfConstruct() != NULL);
     ROSE_ASSERT(decl->get_definition()->get_endOfConstruct()   != NULL);

#if 0
     printf ("In parse_function_body(): The function body (SgBasicBlock) should have proper source position information. \n");
     ROSE_ASSERT(decl->get_definition()->get_body() != NULL);
     ROSE_ASSERT(decl->get_definition()->get_body()->get_startOfConstruct() != NULL);
     decl->get_definition()->get_body()->get_startOfConstruct()->display("function body (SgBasicBlock): debug");
     decl->get_definition()->get_body()->get_endOfConstruct()  ->display("function body (SgBasicBlock): debug");
#endif

  // DQ (11/2/2016): Make this a warning since we have to handle the case where some IR nodes are marked (isSourcePositionUnavailableInFrontend() == true). 
  // DQ (8/21/2012): This is no longer tru now that we use the original body that came in the SgFunctionDefinition.
  // The function definition should not have been set yet with source position information (but will have a Sg_File_Info object).
     if (decl->get_definition()->get_startOfConstruct()->isSourcePositionUnavailableInFrontend() == true)
        {
          printf ("ERROR: In parse_function_body(): definition marked as isSourcePositionUnavailableInFrontend() == true: decl->get_name() = %s \n",decl->get_name().str());
        }
   // ROSE_ASSERT(decl->get_definition()->get_startOfConstruct()->isSourcePositionUnavailableInFrontend() == false);

#if 0
     printf ("In parse_function_body(): The function definition should have proper source position information. \n");
     decl->get_definition()->get_startOfConstruct()->display("function definition: debug");
     decl->get_definition()->get_endOfConstruct()  ->display("function definition: debug");
#endif

  // DQ (12/20/2012): Check the physical source position information.
     if (decl->get_definition()->get_startOfConstruct()->get_physical_file_id() < 0)
        {
       // DQ (12/23/2012): We can't make this an error because "void bar2() try {} catch (int) {}" will generated a compiler generated body.
          if (mlog[Rose::Diagnostics::DEBUG])
             {
               decl->get_definition()->get_startOfConstruct()->display("function definition: debug");
             }
          mprintf ("WARNING: physical source position not set properly \n");
        }

#if 0
  // DQ (4/26/2013): Debugging code.
     printf ("In parse_function_body(): Calling testFunctionCallArguments() \n");
     testFunctionCallArguments(decl);
#endif
   }

template < class SgTemplateDeclType >
void copyTemplateArgumentsFromNondefiningToDefiningDeclaration(SgFunctionDeclaration* defining_declaration)
   {
  // DQ (7/25/2012): This is a refactoring of the support to copy the template arguments from the non-defining declaration to the defining declaration.
  // This code is instantiated for all of the different types of templates.  It acesses member functions that are
  // seperately available on each of the different types of template IR nodes.

  // DQ (7/21/2012): This code is part of fixing test2012_132.C; the template arguement lists are not consistant 
  // (the defining declaration's template argument list is not set and so that name is not computed correctly).
  // However, it might be that this must be done earlier than at the end of this function.
     SgTemplateDeclType* templateInstantiation = dynamic_cast<SgTemplateDeclType*>(defining_declaration);
     if (templateInstantiation != NULL)
        {
#if 0
          printf ("In copyTemplateArgumentsFromNondefiningToDefiningDeclaration(): templateInstantiationFunctionDeclaration->get_templateArguments() = %" PRIuPTR " \n",templateInstantiation->get_templateArguments().size());
#endif
          SgTemplateDeclType* nondefining_templateInstantiation = dynamic_cast<SgTemplateDeclType*>(defining_declaration->get_firstNondefiningDeclaration());
#if 0
          if (nondefining_templateInstantiation != NULL)
             {
               printf ("In copyTemplateArgumentsFromNondefiningToDefiningDeclaration(): nondefining_templateInstantiationFunctionDeclaration->get_templateArguments() = %" PRIuPTR " \n",nondefining_templateInstantiation->get_templateArguments().size());
             }
#endif
          SgTemplateDeclType* defining_templateInstantiation = dynamic_cast<SgTemplateDeclType*>(defining_declaration->get_definingDeclaration());
#if 0
          if (defining_templateInstantiation != NULL)
             {
               printf ("In copyTemplateArgumentsFromNondefiningToDefiningDeclaration(): defining_templateInstantiationFunctionDeclaration->get_templateArguments() = %" PRIuPTR " \n",defining_templateInstantiation->get_templateArguments().size());
             }
#endif
          if (nondefining_templateInstantiation != NULL && defining_templateInstantiation != NULL)
             {
               if (nondefining_templateInstantiation->get_templateArguments().size() != defining_templateInstantiation->get_templateArguments().size())
                  {
                 // Set the STL vector in the defining declaration equal to the STL vector in the nondefining declaration.
                    ROSE_ASSERT(nondefining_templateInstantiation->get_templateArguments().size() != 0);
#if 1
                    defining_templateInstantiation->get_templateArguments() = nondefining_templateInstantiation->get_templateArguments();
#endif
#if 1
                    testTemplateArgumentParents(defining_templateInstantiation->get_templateArguments(),nondefining_templateInstantiation);
#else
                 // DQ (7/25/2012): The parent should point to the SgTemplateInstantiationDecl, not the SgGlobal.
                    SgTemplateArgumentPtrList templateArgumentsList = defining_templateInstantiation->get_templateArguments();
                    for (size_t i = 0; i < templateArgumentsList.size(); i++)
                       {
                      // DQ (7/25/2012): I don't know if we can assert these conditions.
                         ROSE_ASSERT(templateArgumentsList[i]->get_parent() != NULL);
                         ROSE_ASSERT(templateArgumentsList[i]->get_parent() == nondefining_templateInstantiation);

                      // templateArgumentsList[i]->set_parent(firstNondefiningClassDeclaration);
                       }
#endif
                  }
             }
            else
             {
               printf ("defining_templateInstantiation    = %p \n",defining_templateInstantiation);
               printf ("nondefining_templateInstantiation = %p \n",nondefining_templateInstantiation);

               printf ("We should have both a defining an not defining declaration \n");
               ROSE_ASSERT(false);
             }

          ROSE_ASSERT(defining_templateInstantiation != NULL);
          ROSE_ASSERT(nondefining_templateInstantiation != NULL);

#if 1
          ROSE_ASSERT(nondefining_templateInstantiation->get_templateArguments().size() == defining_templateInstantiation->get_templateArguments().size());
#endif

          testTemplateArgumentParents(nondefining_templateInstantiation->get_templateArguments(),nondefining_templateInstantiation);
          testTemplateArgumentParents(defining_templateInstantiation->get_templateArguments(),nondefining_templateInstantiation);
#if 0
          printf ("In copyTemplateArgumentsFromNondefiningToDefiningDeclaration(): defining_templateInstantiation    = %p get_name() = %s templateName = %s \n",
               defining_templateInstantiation,defining_templateInstantiation->get_name().str(),defining_templateInstantiation->get_templateName().str());
          printf ("In copyTemplateArgumentsFromNondefiningToDefiningDeclaration(): nondefining_templateInstantiation = %p get_name() = %s templateName = %s \n",
               nondefining_templateInstantiation,nondefining_templateInstantiation->get_name().str(),nondefining_templateInstantiation->get_templateName().str());
#endif
        }
   }


template <class T>
void displayMap( const T & m, const std::string & label  )
   {
     printf ("displayMap called with label = %s \n",label.c_str());

     typename T::const_iterator i = m.begin();
     int counter = 1;
     while (i != m.end())
        {
          printf ("#%5d: i->first = %p i->second = %p = %s \n",counter,i->first,i->second,i->second->class_name().c_str());
          SgFunctionDeclaration* functionDeclaration = isSgFunctionDeclaration(i->second);
          if (functionDeclaration != NULL)
             {
               printf ("   function name = %s \n",functionDeclaration->get_name().str());
             }

          i++;
          counter++;
        }
   }

